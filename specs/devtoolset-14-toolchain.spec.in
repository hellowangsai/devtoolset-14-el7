Name:           @TOOLSET@-toolchain
Version:        14.0
Release:        1%{?dist}
Summary:        Core compiler toolchain for @TOOLSET@
License:        GPLv3+
BuildArch:      noarch
Requires:       @TOOLSET@ = %{version}-%{release}
Requires:       @TOOLSET@-runtime = %{version}-%{release}
Requires:       @TOOLSET@-binutils
Requires:       @TOOLSET@-elfutils
Requires:       @TOOLSET@-make
Requires:       @TOOLSET@-gcc
Requires:       @TOOLSET@-gcc-c++
Requires:       @TOOLSET@-gcc-gfortran
Requires:       @TOOLSET@-gdb
Requires:       @TOOLSET@-dwz
Requires:       @TOOLSET@-annobin-plugin-gcc
Requires:       @TOOLSET@-annobin-annocheck
Requires:       libasan8
Requires:       @TOOLSET@-libasan-devel
Requires:       libtsan
Requires:       @TOOLSET@-libtsan-devel
Requires:       liblsan
Requires:       @TOOLSET@-liblsan-devel
Requires:       libubsan1
Requires:       @TOOLSET@-libubsan-devel

%description
Core compiler toolchain meta package for @TOOLSET@.

This first-stage toolchain explicitly includes the ASan, TSan, LSan, and UBSan
runtime/development packages, plus the annobin GCC plugin and annocheck.

