Name:           @TOOLSET@-runtime
Version:        14.0
Release:        1%{?dist}
Summary:        Runtime environment for @TOOLSET@ Software Collection
License:        GPLv3+
BuildArch:      noarch
Requires:       scl-utils

%description
Runtime package for @TOOLSET@ on CentOS 7.

This package installs the SCL prefix file and the environment enable script
used by `scl enable @TOOLSET@ bash`.

%install
mkdir -p %{buildroot}@SCL_ROOT@
mkdir -p %{buildroot}@PREFIX@/etc/alternatives
mkdir -p %{buildroot}@PREFIX@/var/lib/alternatives
mkdir -p %{buildroot}/etc/scl/conf
mkdir -p %{buildroot}/etc/scl/prefixes
cat > %{buildroot}@SCL_ROOT@/enable <<'EOF_ENABLE'
export PATH=@PREFIX@/usr/bin${PATH:+:${PATH}}
export LD_LIBRARY_PATH=@PREFIX@/usr/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
export LIBRARY_PATH=@PREFIX@/usr/lib64${LIBRARY_PATH:+:${LIBRARY_PATH}}
export MANPATH=@PREFIX@/usr/share/man${MANPATH:+:${MANPATH}}
export INFOPATH=@PREFIX@/usr/share/info${INFOPATH:+:${INFOPATH}}
export PKG_CONFIG_PATH=@PREFIX@/usr/lib64/pkgconfig:@PREFIX@/usr/share/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}
export CPATH=@PREFIX@/usr/include${CPATH:+:${CPATH}}
export XDG_DATA_DIRS=@PREFIX@/usr/share${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}
EOF_ENABLE
chmod 0755 %{buildroot}@SCL_ROOT@/enable
echo /opt/rh > %{buildroot}/etc/scl/conf/@TOOLSET@
echo /opt/rh > %{buildroot}/etc/scl/prefixes/@TOOLSET@

%files
 /etc/scl/conf/@TOOLSET@
%dir @PREFIX@/etc/alternatives
%dir @PREFIX@/var/lib/alternatives
@SCL_ROOT@/enable
/etc/scl/prefixes/@TOOLSET@

%changelog
